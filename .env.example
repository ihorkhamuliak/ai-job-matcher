# Copy to .env and fill in yourself. .env never goes to git.

# Scoring and CV choice
ANTHROPIC_API_KEY=

# Telegram digest and buttons (the bot answers only this chat)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: a separate channel for CV packages
TELEGRAM_PACKAGES_CHAT_ID=
# Optional: weekly encrypted backup channel
TELEGRAM_BACKUPS_CHAT_ID=

# Optional: Google Sheet for applications
PODACHI_SHEET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
